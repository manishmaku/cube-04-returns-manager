# Cube Buildathon 2026 - Returns Manager Configuration
# Phase 1 Foundation

# Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_PATH=data/returns_records.db

# Storage
IMAGE_STORAGE_PATH=data/images

# Security / Tenants
ALLOWED_ORGS=org_demo_alpha,org_demo_bravo
API_KEY=dev-secret-key-change-in-production

# Gemini Model (Used in Phase 2+)
# Options: gemini-2.5-flash (default), gemini-3.8-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
